# The Anthropic API key powering the agent (src/agent/agent.py). Never commit a real key.
ANTHROPIC_API_KEY=sk-ant-...

# operations-performance's API -- this project consumes it as agent tools rather than
# reimplementing any analytics. See src/tools/*.py.
OPS_PERFORMANCE_API_URL=http://localhost:8000

# Vector store (Chroma, local persistent mode for this project's size -- see docs/rag-design.md
# for why a hosted vector DB isn't necessary here)
CHROMA_PERSIST_DIR=./data/chroma

# API server
API_ALLOWED_ORIGINS=http://localhost:3000

# API authentication (src/api/auth.py) -- every endpoint except GET /health requires
# this exact value in an X-API-Key request header. Fails open if unset (local-dev
# default, matching operations-performance's identical mechanism) -- a real
# deployment MUST set this, and /chat and /investigate calling a real LLM per
# request makes this matter more here than in the read-only companion project.
API_KEY=changeme-generate-a-real-secret
API_PORT=8001
