# The Anthropic API key powering the agent (src/agent/agent.py). Never commit a real key.
# Only needed if AGENT_PROVIDER=anthropic (or unset, since that's config/agent.yaml's
# committed default).
ANTHROPIC_API_KEY=sk-ant-...

# Which model provider src/agent/agent.py's run_agent() dispatches to -- anthropic
# (default), groq, or gemini. See src/agent/providers.py for the Groq/Gemini
# implementations. Overrides config/agent.yaml's committed "anthropic" default without
# editing that file (kept stable for tests/test_agent.py's Anthropic-shaped fake clients).
AGENT_PROVIDER=groq
# Check https://console.groq.com/docs/models for the current list -- Groq's hosted
# lineup changes over time (llama-3.3-70b-versatile, an earlier default here, was
# retired; openai/gpt-oss-120b was confirmed working via `client.models.list()` as of
# this project's live deployment).
AGENT_MODEL=openai/gpt-oss-120b

# Free key from console.groq.com -- only needed if AGENT_PROVIDER=groq.
GROQ_API_KEY=gsk_...

# Free key from aistudio.google.com/apikey -- only needed if AGENT_PROVIDER=gemini.
# If using Gemini, also set AGENT_MODEL=gemini-1.5-flash (or current Gemini model name).
GEMINI_API_KEY=...

# operations-performance's API -- this project consumes it as agent tools rather than
# reimplementing any analytics. See src/tools/*.py.
OPS_PERFORMANCE_API_URL=http://localhost:8000
# Must match operations-performance's own API_KEY (src/api/auth.py over there) once that
# project has one set -- src/tools/client.py sends this as X-API-Key on every call.
OPS_PERFORMANCE_API_KEY=changeme-generate-a-real-secret

# Vector store (Chroma, local persistent mode for this project's size -- see docs/rag-design.md
# for why a hosted vector DB isn't necessary here)
CHROMA_PERSIST_DIR=./data/chroma

# API server
API_ALLOWED_ORIGINS=http://localhost:3000

# API authentication (src/api/auth.py) -- every endpoint except GET /health requires
# this exact value in an X-API-Key request header. Fails open if unset (local-dev
# default, matching operations-performance's identical mechanism) -- a real
# deployment MUST set this, and /chat and /investigate calling a real LLM per
# request makes this matter more here than in the read-only companion project.
API_KEY=changeme-generate-a-real-secret
API_PORT=8001
